# Documentation-only shape of /etc/spaceofthoughts/api.env.
# `sudo spotctl setup` generates the real root:root 0600 file atomically.
# Never place real credentials in this example or in the repository.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

ConnectionStrings__SpaceOfThoughtsConnectionString="Host=127.0.0.1;Port=5432;Database=spotdb;Username=spaceofthoughts;Password=<spotctl-generated-64-character-hex-password>"

Jwt__Issuer=https://spaceofthoughts.com
Jwt__Audience=https://spaceofthoughts.com
Jwt__Key="<spotctl-generated-Base64-key>"

DataProtection__KeysPath=/var/lib/spaceofthoughts/data-protection-keys
ImageStorage__RootPath=/var/lib/spaceofthoughts/images

BootstrapAdmin__UserName="<administrator-username>"
BootstrapAdmin__Email="<administrator-email>"

# BootstrapAdmin__InitialPassword is intentionally absent. spotctl sends the
# password to the API provisioning command over standard input only.

# Third-party credentials the API needs, such as an email provider's API key, do
# not belong here either: spotctl regenerates this file and would discard them.
# Give each one its own root-only file attached by a systemd drop-in, as
# described under "Operator-supplied secrets the API itself needs" in SECRETS.md.
