# Copy this file to /etc/spaceofthoughts/spaceofthoughts.env on the server.
# Never place real credentials in this example or in the repository.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://127.0.0.1:5000

ConnectionStrings__SpaceOfThoughtsConnectionString="Host=<database-host>;Port=5432;Database=spotdb;Username=<database-user>;Password=<database-password>"

Jwt__Issuer=https://spaceofthoughts.com
Jwt__Audience=https://spaceofthoughts.com
Jwt__Key="<Base64-encoded-32-byte-or-longer-random-key>"

DataProtection__KeysPath=/var/lib/spaceofthoughts/data-protection-keys

# Supply this only while provisioning a fresh authentication database. Remove it
# from the server after the initial administrator has been created successfully.
# BootstrapAdmin__InitialPassword=<unique-initial-administrator-password>
