# Cloudflare API token with DNS Write permission for only the required zone.
# Use a dedicated token; do not reuse the Certbot token or put this in api.env.
CF_API_TOKEN=REPLACE_WITH_DEDICATED_DDNS_TOKEN

# Cloudflare zone and the one existing AAAA record managed by this updater.
CF_ZONE_ID=REPLACE_WITH_32_CHARACTER_ZONE_ID
CF_RECORD_NAME=spaceofthoughts.com
# Proxied records must use CF_TTL=1 (Cloudflare Automatic).
CF_TTL=300
CF_PROXIED=false

# Interface and stable host portion of the production server's global IPv6
# address. Use enough hexadecimal groups to identify exactly one address.
# Unique Local Addresses (fc00::/7) are skipped automatically, so a router that
# advertises both a ULA and a real global prefix needs no longer suffix here;
# SLAAC gives both addresses the same host bits, which no suffix could separate.
IPV6_INTERFACE=eth0
IPV6_SUFFIX=REPLACE_WITH_STABLE_IPV6_HOST_SUFFIX
